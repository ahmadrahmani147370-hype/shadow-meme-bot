# SHADOW MEME settings. Copy to .env (setup_termux.sh does this) and fill in.
# NEVER put a wallet private key, seed phrase or exchange key here: the bot does not need one.

# --- Telegram (required: the bot is controlled only from Telegram).
# Decided bot: the existing @Fathersigna147lBot (paste its token from @BotFather; never share it).
# Owner chat id: 7922990181 (commands are accepted only from this chat; everyone else is ignored).
# Only ONE program may use a bot token at a time - make sure the old FATHER bot is stopped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=7922990181
# If api.telegram.org times out on your network (seen in Pakistan), try another network or the
# 1.1.1.1 (WARP) app first. Advanced: point this at your own HTTPS Bot API mirror/proxy.
TELEGRAM_API_BASE=https://api.telegram.org
# "SHADOW MEME bot online (paper-only)" message at every start
TELEGRAM_STARTUP_MESSAGE=true   # only used with TELEGRAM_NOTIFY=all
# Testing only: alerts are written to the log instead of Telegram (command replies still sent)
TELEGRAM_ALERTS_DRYRUN=false
# Alert rate limits: SELL max 1 per coin+strategy per N min, HOLD max 1 per coin per N min (or off),
# REJECTs only as one digest per N min (0 = no digest), max signal alerts per minute
TELEGRAM_HOLD_ALERTS=true
TELEGRAM_SELL_COOLDOWN_MIN=10
TELEGRAM_HOLD_COOLDOWN_MIN=30
TELEGRAM_REJECT_DIGEST_MIN=60
TELEGRAM_MAX_ALERTS_PER_MIN=20
# Messages kept while Telegram is unreachable; long-poll timeout; min gap between messages
TELEGRAM_QUEUE_MAX=300
TELEGRAM_POLL_TIMEOUT_SEC=25
TELEGRAM_SEND_INTERVAL_SEC=1.1
# Chat menu button that opens the dashboard Mini App
TELEGRAM_MENU_BUTTON=true
# Testing only: no Telegram network calls at all (sends are written to the log)
TELEGRAM_LOG_ONLY=false
# HEALTH log line (memory, CPU, DB size, API calls / 429s, event-loop lag) every N seconds
HEALTH_LOG_SEC=300

# --- Dashboard (phase 9): Telegram Mini App on GitHub Pages.
# Optional. Without a token the dashboard shows the summary carried in the bot's link only.
# With a fine-grained token (this repo only, Contents: Read and write) the bot uploads the full
# sanitized snapshot to the dashboard-data branch every DASHBOARD_PUSH_MIN minutes. Never share it.
GITHUB_TOKEN=
GITHUB_REPO=ahmadrahmani147370-hype/shadow-meme-bot
DASHBOARD_URL=https://ahmadrahmani147370-hype.github.io/shadow-meme-bot/
DASHBOARD_BRANCH=dashboard-data
# Who uploads the snapshot: auto (GITHUB_TOKEN if set) | token | gh (a PC/box where `gh auth login` was done:
# uses the GitHub CLI's own login, no token in this file) | off
DASHBOARD_PUBLISHER=auto
DASHBOARD_PUSH_MIN=5

# --- Safety. Fixed to true. Changing it does nothing: live trading does not exist in this bot.
PAPER_ONLY=true

# --- Data sources (free, keyless by default)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK=https://solana-rpc.publicnode.com
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
# Optional free keys that only raise rate limits:
JUPITER_API_KEY=
RUGCHECK_API_KEY=
# Birdeye is not used by default (it refuses keyless requests):
BIRDEYE_API_KEY=
HTTP_TIMEOUT_SEC=15

# --- Storage
DB_PATH=data/shadow.db
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Scanner
SCAN_INTERVAL_SEC=20
MAX_TOKEN_AGE_MIN=120
# PumpPortal's free websocket delivered only ~20-35% of new pump.fun launches in our test,
# so GeckoTerminal + RugCheck are also polled while the websocket is up (true = recommended).
SCANNER_POLL_ALWAYS=true
# Poll intervals (kept under the free limits: GeckoTerminal ~10/min, RugCheck ~1-3/s)
GT_POLL_SEC=20
RC_POLL_SEC=6
# Reconnect the websocket if it is silent this long; start fallback polling after this long down
WS_IDLE_TIMEOUT_SEC=120
FALLBACK_AFTER_SEC=20

# --- Collector (phase 3)
# Max tokens polled for price snapshots at once. 200 = 7 DexScreener batch calls per 15 s snapshot
# (28/min of the free 300/min). Lower it (e.g. 80) on an old phone or a slow network.
MAX_TRACKED=200
# A token needs this many trades (buys+sells) before it is tracked; quieter ones are re-checked
# until NO_PAIR_TTL_SEC and then dropped as "inactive"
MIN_TRACK_TXNS=5
# A tracked token can't be pushed out by a busier one during its first N seconds
MIN_HOLD_SEC=120
SNAPSHOT_SEC=15
ENRICH_SEC=5
# Drop tokens with no DexScreener pair after this many seconds
NO_PAIR_TTL_SEC=300
# Stop tracking a token with no trades for this many minutes
DEAD_AFTER_MIN=10
# Top-N tokens by 5-minute volume that also get GeckoTerminal 1m OHLCV
HOT_SIZE=3
HOT_REFRESH_SEC=180
# Jupiter price + liquidity fill-in (DexScreener has no liquidity for pump.fun bonding pairs)
JUP_REFRESH_SEC=60
# Retention (keeps the database around 100 MB at 200 tracked tokens; see README)
SNAPSHOT_RETENTION_H=3
CANDLE_RETENTION_H=4
MARKET_RETENTION_D=0.5
SEEN_RETENTION_D=1

# --- Safety checker (phase 4), STRICT defaults. Percentages are % of total supply.
# Any CRITICAL flag rejects the token whatever its score: mint/freeze authority, dangerous Token-2022
# extensions (incl. an authority that can add a fee or hook later), rugged, rug warning (liquidity or
# price collapse), not sellable / sell impact / sell loss too high, extreme holder, insider or dev
# concentration, creator with rugged tokens or blacklisted, extreme serial creator, liquidity below the
# floor, wash volume, few makers. Without a RugCheck report the verdict is UNKNOWN (never tradable).
# Reject when the 0-100 safety sub-score is below this
SAFETY_MIN_SCORE=70
SAFETY_REQUIRE_RUGCHECK=true
# Re-check (RugCheck + RPC) after N seconds; rejected tokens less often; a sell quote is valid N seconds
SAFETY_TTL_SEC=900
SAFETY_REJECT_TTL_SEC=1800
SAFETY_QUOTE_TTL_SEC=180
# Budgets: RugCheck reports per minute for safety (the scanner polls RugCheck ~10/min separately,
# both stay under ~1 req/s) and Jupiter sell quotes per minute (keyless Jupiter = 30/min shared with
# the collector's price fill-in, ~4/min at 200 tracked)
SAFETY_RC_PER_MIN=30
SAFETY_QUOTES_PER_MIN=8
# Until phase 5 exists, the live test quotes passing tokens with at least this 5-minute volume (USD)
SAFETY_QUOTE_MIN_VOL5M=500
# Holder concentration (pools, lockers, bonding curves and the pump.fun mayhem wallet are excluded)
SAFETY_TOP1_CRIT_PCT=30
SAFETY_TOP10_CRIT_PCT=60
SAFETY_TOP1_DANGER_PCT=15
SAFETY_TOP10_DANGER_PCT=40
SAFETY_INSIDER_CRIT_PCT=25
SAFETY_INSIDER_DANGER_PCT=10
SAFETY_DEV_HOLD_CRIT_PCT=20
SAFETY_DEV_HOLD_DANGER_PCT=5
SAFETY_DEV_BUY_WARN_SOL=5
# Same creator launched this many tokens in 24 h (seen here or known to RugCheck): danger / critical
SAFETY_SERIAL_CREATOR=3
SAFETY_SERIAL_CREATOR_CRIT=10
# Liquidity for new launches: critical / danger / warn below (USD)
SAFETY_CRIT_LIQ_USD=1500
SAFETY_MIN_LIQ_USD=3000
SAFETY_WARN_LIQ_USD=6000
# Danger floor for the mcap / top-volume universes (coins >= $1M); critical below 1/5 of it
SAFETY_MIN_LIQ_USD_LARGE=50000
# New launches on AMM pools: liquidity / market cap below this = thin liquidity
SAFETY_MIN_LIQ_MCAP=0.05
# Selling PAPER_TRADE_SIZE through Jupiter: price impact danger / critical (%), value lost critical (%)
SAFETY_MAX_IMPACT_DANGER_PCT=5
SAFETY_MAX_IMPACT_CRIT_PCT=15
SAFETY_MAX_SELL_LOSS_PCT=25

# --- Universes (phase 5): MCAP coins and TOP VOLUME coins, tracked separately from new launches, no age limit
# Sources: GeckoTerminal trending / top 24h volume / top tx pools + DexScreener top boosts, ranked via DexScreener
UNIVERSES_ENABLED=true
# MCAP universe: every Solana meme coin with market cap >= this (USD); max tracked; min liquidity
UNIVERSE_MCAP_MIN=1000000
UNIVERSE_MCAP_MAX=100
UNIVERSE_MCAP_MIN_LIQ=25000
# TOP VOLUME universe: top N by 24h volume + top N by 1h volume, max tracked, minimum liquidity / mcap
UNIVERSE_VOLUME_TOP_N=30
UNIVERSE_VOLUME_MAX=50
UNIVERSE_VOLUME_MIN_LIQ=20000
UNIVERSE_VOLUME_MIN_MCAP=100000
# ...and real volume: at least this 24h volume (for the 24h list) / 1h volume (for the 1h list), USD
UNIVERSE_VOLUME_MIN_VOL_H24=300000
UNIVERSE_VOLUME_MIN_VOL_H1=25000
# Snapshot every N s (DexScreener, 30 coins per call); re-discover lists every N s (GeckoTerminal)
UNIVERSE_REFRESH_SEC=30
UNIVERSE_DISCOVER_SEC=300
UNIVERSE_GT_PAGES=1
UNIVERSE_MAX_CANDIDATES=300
# SOL, stables, LSTs and tokenized stocks are always dropped; majors (JUP/RAY/BONK/WIF/PUMP...) unless allowed
UNIVERSE_ALLOW_MAJORS=false
# Extra mints to ignore, comma separated
UNIVERSE_EXCLUDE_MINTS=
# Phase 6: one GeckoTerminal OHLCV backfill every N s gives new MCAP / TOP VOLUME members N minutes of history
UNIVERSE_BACKFILL_SEC=60
UNIVERSE_BACKFILL_MINUTES=60

# --- Signals (phase 5): 10 detectors on local 1m candles (+5m resampled), score 0-100
# 80-100 Strong Watch, 65-79 Watch, 50-64 Weak, <50 Reject; a critical safety flag always = REJECT
SIGNAL_EVAL_SEC=15
# Same coin + strategy signals at most once per N minutes; HOLD update for open watches every N minutes
SIGNAL_COOLDOWN_MIN=10
SIGNAL_HOLD_EVERY_MIN=10
# A strategy setup scoring at least this asks the safety checker for a Jupiter sell quote
QUOTE_NEAR_SCORE=55

# --- Judge agent (phase 5): rule-based APPROVE / VETO of every BUY WATCH (free, no LLM)
JUDGE_MIN_CONFIDENCE=0.60
# Veto if selling PAPER_TRADE_SIZE moves the price more than this (%) or loses more than this (%)
JUDGE_MAX_IMPACT_PCT=3
JUDGE_MAX_SELL_LOSS_PCT=10
# Veto below this liquidity: new launches / mcap + volume coins (USD)
JUDGE_MIN_LIQ_NEW=8000
JUDGE_MIN_LIQ_LARGE=75000
# Max open watches of the same strategy in the same universe (+1); same creator/symbol is always vetoed
JUDGE_MAX_CORRELATED=2
# Veto a strategy whose last 10+ virtual watches are in a drawdown of this many % points (or 5 losses in a row)
JUDGE_MAX_STRATEGY_DD_PCT=20

# --- Paper trading (virtual USD)
PAPER_START_BALANCE=100
PAPER_TRADE_SIZE=2
PAPER_BUY_FEE=0.00
PAPER_SELL_FEE=0.00
PAPER_SLIPPAGE_PCT=3
PAPER_MAX_OPEN=5
# Daily target only - weak signals are never forced to reach it:
PAPER_DAILY_TARGET=50
# Only Watch (65-79) and Strong Watch (80-100) may open a paper trade:
MIN_TRADE_SCORE=50   # v1.1: global floor only; each strategy's min_score decides (early_entry 70)
# Entry and exit slippage = the Jupiter quote's price impact for the trade size, at least this (%)
PAPER_MIN_SLIPPAGE_PCT=0.5
# At exit, a quote older than this (s) is not trusted: PAPER_SLIPPAGE_PCT is used instead
PAPER_EXIT_QUOTE_MAX_AGE_SEC=600
# No price for this many minutes -> the paper trade is closed at the last known price
PAPER_NO_PRICE_CLOSE_MIN=30
# Rug guard (phase 7): DexScreener pool liquidity below this ($) = drained -> closed as 'liquidity_gone', valued at the
# last trusted price sold into what is left of the pool (never at the drained pool's dust price)
PAPER_RUG_LIQUIDITY_USD=500
# A price that jumps more than this many x in one update is bad data and ignored
PAPER_MAX_PRICE_JUMP=50
PAPER_EQUITY_EVERY_SEC=60

# --- Self-learning (phase 6): guarded tuning of strategy params and judge thresholds
LEARN_ENABLED=true
LEARN_EVERY_MIN=30
# Closed watches per strategy+universe before any change, and how many must be in the newest (test) part
LEARN_MIN_TRADES=12
LEARN_MIN_TEST=4
# Walk-forward: oldest 70% choose a candidate, newest 30% (never seen while choosing) must confirm it
LEARN_TRAIN_FRAC=0.7
# One param per step, at most this % change; must improve net % per opportunity by this many points
LEARN_MAX_STEP_PCT=20
LEARN_MIN_IMPROVE_PCT=0.5
# At most one change per strategy (and for the judge) per this many hours
LEARN_COOLDOWN_H=3
# A learned version is re-checked after this many live watches; worse than its parent -> automatic rollback
LEARN_ROLLBACK_MIN=6
LEARN_ROLLBACK_MARGIN_PCT=0
# Tune the judge thresholds (confidence, impact, round-trip loss, liquidity floors) under the same rules
JUDGE_TUNING_ENABLED=true

# --- Database (phase 7): crash safety, size limits, backups
# Day boundaries (50-trade counter, daily report, daily backup) use this zone, not the phone's setting
TIMEZONE=Asia/Karachi
DB_BUSY_TIMEOUT_MS=10000
# Hard cap on the database (MB): above it after the normal prune -> emergency prune (never below what live signals need)
DB_MAX_MB=150
# Prune / WAL checkpoint / optimize / backup check every N s (inside the bot: one writer)
MAINTENANCE_SEC=300
OPTIMIZE_EVERY_H=6
# VACUUM at most every N hours, and only when this % of the file is free pages
VACUUM_EVERY_H=24
VACUUM_MIN_FREE_PCT=10
# One verified gzip backup per PKT day, newest N kept
BACKUP_DIR=data/backups
BACKUP_KEEP=7
# state = only what can't be rebuilt (paper account/trades, strategy versions + updates, learning log, judge,
# BUY_WATCH/SELL signals, blacklist) -> a few MB. full = whole database incl. hours of market data
BACKUP_MODE=state
# Signal retention: BUY_WATCH/SELL/HOLD (learning + /history) vs REJECT (~95% of all rows)
SIGNAL_RETENTION_D=30
SIGNAL_REJECT_RETENTION_D=2
# Local blacklist cache of rug creators (RugCheck's creator history keeps flagging them after this)
CREATOR_BLACKLIST_RETENTION_D=14
# Raw scanner JSON (debug only) is dropped after N hours
SEEN_RAW_RETENTION_H=1
SIGNAL_DETAIL_RETENTION_H=24
PAPER_EQUITY_RETENTION_D=30

# --- v1.1: accuracy rules, daily coin cap, buy-only Telegram, fast prices, faster safe learning
# Trade only coins with market cap >= this (new launches below it are still scanned until they cross it)
TRADE_MIN_MCAP_USD=1000000
# Safety checks + scoring start a bit below the floor so a coin crossing $1M is ready
EVAL_MIN_MCAP_USD=750000
# Liquidity filters (13 Nov data: every rugged ">= $1M" coin had liquidity/mcap < 2% or failed safety)
TRADE_MIN_LIQ_USD=50000
TRADE_MIN_LIQ_MCAP=0.02
# Skip the first minutes of launch chaos
TRADE_MIN_AGE_MIN=10
# Max unique coins evaluated (safety check + scoring) per PKT day; 0 = unlimited
COINS_PER_DAY=1000
# v1.1.1: guaranteed minimum per PKT day. When the count falls behind pace (MIN x fraction of the day), the
# EVALUATION market-cap floor steps down these tiers and, at the lowest, discovery is widened. Trading stays >= $1M.
COINS_PER_DAY_MIN=500
EVAL_PACE_FLOORS=750000,250000,100000,50000,25000,10000,5000
PACE_FILL_PER_MIN=10
# trades = push ONLY paper BUY + SELL (position closed: P&L + reason); buy = BUY only; all = every alert like v1.0
# Commands always answer.
TELEGRAM_NOTIFY=trades
# Fast price lane: open positions + watches + near-trigger coins, one DexScreener batch call per tick
FAST_REFRESH_SEC=1
FAST_MAX_MINTS=30
FAST_NEAR_SEC=120
# Self-learning: shrink measured gains toward 0 (gain * n / (n + k)) so small samples need a bigger edge
LEARN_SHRINK_K=20
# Track near-miss setups (score within this margin below min_score) virtually, so learning sees their outcomes
SHADOW_TRACK=true
SHADOW_SCORE_MARGIN=15

# --- v1.1.2 exits: let winners run to +1000%, protect the profit (docs/V112_EXITS.md)
EXIT_POLICY=run                # run | classic (v1.1.1 per-strategy TP / trail / time stop)
EXIT_TP_PCT=1000               # take profit (never below 1000 for self-learning)
EXIT_BE_TRIGGER_PCT=15         # protected once the peak reaches +15%
EXIT_BE_LOCK_PCT=2             # protected stop never below entry +2%
EXIT_TRAIL_TIERS=50:10,100:15,300:25,inf:30   # trail % from the peak by peak gain
EXIT_PARTIAL_PCT=30            # sell part once at +30%
EXIT_PARTIAL_FRAC=0.5          # 50% (0 = no partial)
EXIT_MAX_HOLD_H=24             # protected trades: max hold
EXIT_SL_PCT=20                 # v1.1.3: stop loss exactly -20% from entry, locked (0 = per strategy, learnable)
